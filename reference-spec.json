  "animations": [
    {
      "id": "anim_hero_card_shrink_and_dock",
      "trigger": "scrollScrub",
      "target": "#hero-protagonist-card",
      "initialState": { "scale": 1.0, "x": "0vw", "y": "0vh", "opacity": 1.0 },
      "finalState": { "scale": 0.55, "x": "16vw", "y": "36vh", "opacity": 1.0 },
      "duration": "100vh",
      "delay": 0,
      "easing": "power2.out",
      "direction": "diagonalDownRight",
      "scrubBehavior": { "start": "top top", "end": "+=100%", "scrub": 0.5 },
      "viewportBehavior": "pinnedUntilDocked"
    },
    {
      "id": "anim_intro_columns_stagger_enter",
      "trigger": "scrollTrigger",
      "target": ".intro-col",
      "initialState": { "opacity": 0, "y": 60 },
      "finalState": { "opacity": 1, "y": 0 },
      "duration": 0.8,
      "delay": 0.1,
      "easing": "power3.out",
      "direction": "up",
      "scrubBehavior": null,
      "viewportBehavior": "staggeredByColumn0.15s"
    },
    {
      "id": "anim_telemetry_narrative_scrub",
      "trigger": "scrollScrub",
      "target": ".telemetry-narrative-group",
      "initialState": { "opacity": 0, "y": 40 },
      "finalState": { "opacity": 1, "y": 0 },
      "duration": "80vh",
      "delay": 0,
      "easing": "power1.out",
      "direction": "up",
      "scrubBehavior": { "start": "top top", "end": "+=80%", "scrub": 1.0 },
      "viewportBehavior": "pinnedFade"
    },
    {
      "id": "anim_aircraft_flight_path",
      "trigger": "continuous",
      "target": "#drone-aircraft-vector",
      "initialState": { "x": "-10vw", "y": "0px" },
      "finalState": { "x": "40vw", "y": "-20px" },
      "duration": 18.0,
      "delay": 0,
      "easing": "linear",
      "direction": "topRight",
      "scrubBehavior": null,
      "viewportBehavior": "loopInfinite"
    },
    {
      "id": "anim_capsule_matrix_wipe",
      "trigger": "scrollScrub",
      "target": ".matrix-capsule-col",
      "initialState": { "yPercent": 100 },
      "finalState": { "yPercent": -100 },
      "duration": "80vh",
      "delay": 0,
      "easing": "power2.inOut",
      "direction": "verticalCurtain",
      "scrubBehavior": { "start": "top bottom", "end": "bottom top", "scrub": 0.8 },
      "viewportBehavior": "staggeredColumnWipe"
    },
    {
      "id": "anim_collectibles_fan_spread",
      "trigger": "scrollScrub",
      "target": ".collectible-card-item",
      "initialState": { "xPercent": 50, "scale": 0.9, "opacity": 0.7 },
      "finalState": { "xPercent": 0, "scale": 1.0, "opacity": 1.0 },
      "duration": "140vh",
      "delay": 0,
      "easing": "power2.out",
      "direction": "horizontalSpread",
      "scrubBehavior": { "start": "top top", "end": "+=120%", "scrub": 1.2 },
      "viewportBehavior": "pinnedHorizontalTrack"
    },
    {
      "id": "anim_citadel_mask_expand",
      "trigger": "scrollScrub",
      "target": "#citadel-folder-tab-mask",
      "initialState": { "scale": 0.85, "borderRadius": "40px" },
      "finalState": { "scale": 1.0, "borderRadius": "20px" },
      "duration": "80vh",
      "delay": 0,
      "easing": "power2.out",
      "direction": "scaleUp",
      "scrubBehavior": { "start": "top center", "end": "center center", "scrub": 0.6 },
      "viewportBehavior": "pinnedScale"
    },
    {
      "id": "anim_overlook_depth_parallax",
      "trigger": "scrollScrub",
      "target": ".overlook-character-fg",
      "initialState": { "y": 60, "scale": 1.0 },
      "finalState": { "y": -40, "scale": 1.05 },
      "duration": "120vh",
      "delay": 0,
      "easing": "none",
      "direction": "parallaxUp",
      "scrubBehavior": { "start": "top top", "end": "+=100%", "scrub": true },
      "viewportBehavior": "multiDepthScrub"
    },
    {
      "id": "anim_become_keeper_scramble",
      "trigger": "viewportEntry",
      "target": "#become-keeper-scramble-text",
      "initialState": { "text": "What path?..." },
      "finalState": { "text": "What path will you forge as you become the Keeper of your destiny?" },
      "duration": 1.2,
      "delay": 0.3,
      "easing": "steps(24)",
      "direction": "scrambleTypewriter",
      "scrubBehavior": null,
      "viewportBehavior": "playOnceOnEnter"
    },
    {
      "id": "anim_monolith_columns_rise",
      "trigger": "scrollScrub",
      "target": ".monolith-column-box",
      "initialState": { "yPercent": 100 },
      "finalState": { "yPercent": 0 },
      "duration": "60vh",
      "delay": 0,
      "easing": "power3.out",
      "direction": "up",
      "scrubBehavior": { "start": "top bottom", "end": "bottom bottom", "scrub": 0.7 },
      "viewportBehavior": "staggeredRise0.1s"
    },
    {
      "id": "anim_progress_bar_horizontal",
      "trigger": "scrollScrub",
      "target": "#hud-progress-line-bar",
      "initialState": { "scaleX": 0 },
      "finalState": { "scaleX": 1.0 },
      "duration": "fullPageScroll",
      "delay": 0,
      "easing": "linear",
      "direction": "horizontalScale",
      "scrubBehavior": { "start": "top top", "end": "bottom bottom", "scrub": 0.1 },
      "viewportBehavior": "persistentTop"
    }
  ],
  "interactions": [
    {
      "id": "int_nav_tab_jump",
      "target": ".hud-nav-tab",
      "event": "click",
      "action": "smoothScrollToTarget",
      "feedback": { "toggleActiveDot": true, "updateUrlHash": false }
    },
    {
      "id": "int_click_and_hold_radar",
      "target": "#click-hold-reticle",
      "event": "pointerdown / pointerup",
      "action": "fillRadarRing",
      "parameters": {
        "holdDurationMs": 1500,
        "onComplete": "openFactionModal",
        "onCancel": "resetRadarFill"
      }
    },
    {
      "id": "int_collectibles_card_hover",
      "target": ".collectible-card-item",
      "event": "mouseenter / mouseleave",
      "action": "elevateAndGlow",
      "parameters": {
        "transform": "translateY(-12px) scale(1.04)",
        "boxShadow": "0 16px 36px rgba(0, 0, 0, 0.4)",
        "duration": "0.3s"
      }
    },
    {
      "id": "int_audio_visualizer_toggle",
      "target": "#btn-audio-toggle",
      "event": "click",
      "action": "toggleAmbientAudioNode",
      "feedback": {
        "animateWaveformBars": true,
        "fadeGainRamp": "1.2s"
      }
    },
    {
      "id": "int_link_sliding_fill",
      "target": ".link-hover-fill",
      "event": "mouseenter / mouseleave",
      "action": "slideBackgroundFill",
      "parameters": {
        "fillColor": "#FFFFFF",
        "textColor": "#000000",
        "ease": "cubic-bezier(0.16, 1, 0.3, 1)"
      }
    }
  ],
  "responsive": {
    "breakpoints": {
      "mobile": "320px to 767px",
      "tablet": "768px to 1023px",
      "desktop": "1024px to 1599px",
      "wide": "1600px+"
    },
    "rules": {
      "mobile": {
        "disableLeftRail": true,
        "collapseNavTabsToHamburger": true,
        "stackAsymmetricColumnsVertically": true,
        "enableHorizontalTouchSwipeForCollectibles": true,
        "scaleMegaWatermarksToContainerWidth": true
      },
      "desktop": {
        "persistentHudFrame": true,
        "enableMouseParallax": true,
        "pinnedStageMultiPhaseScrub": true
      }
    }
  },
  "content": {
    "siteTitle": "Anjishnu | Story",
    "metaDescription": "Enter New Eden. A cinematic world of Keepers, digital collectibles, and opposing factions struggling for the future of humanity.",
    "chapters": [
      { "id": "project", "number": "001", "name": "PROJECT", "headline": "A FAMILIAR WORLD... SET ON A DIFFERENT PATH." },
      { "id": "keep", "number": "002", "name": "THE KEEP", "headline": "YOU ARE A KEEPER: AN AGENT OF POWER AND CHANGE IN THIS WORLD." },
      { "id": "collectibles", "number": "003", "name": "COLLECTION", "headline": "10,000 UNIQUE DIGITAL COLLECTIBLES." },
      { "id": "factions", "number": "002", "name": "FACTIONS", "headline": "One world, two factions. Divided in belief, united in purpose." },
      { "id": "world", "number": "004", "name": "THE WORLD", "headline": "What path will you forge as you become the Keeper of your destiny?" }
    ],
    "footer": {
      "wordmark": "ANJISHNU",
      "copyright": "© 2026 ANJISHNU. ALL RIGHTS RESERVED."
    }
  },
  "routing": {
    "mode": "singlePageVirtualScroll",
    "hashAnchors": {
      "#chapter-project": "section_hero_genesis",
      "#chapter-keep": "section_keep_telemetry",
      "#chapter-factions": "section_factions_citadel",
      "#chapter-world": "section_world_keepers"
    }
  },
  "implementation": {
    "framework": "Nuxt 3 (Vue 3, <script setup lang=\"ts\">)",
    "styling": "Vanilla Scoped CSS with CSS Custom Properties",
    "smoothScrollEngine": "Lenis",
    "timelineOrchestrator": "GSAP 3 with ScrollTrigger",
    "webGlEngine": "Three.js (for atmospheric depth, particles, and wireframe contour mesh)",
    "audioArchitecture": "Web Audio API Harmonic Drone Synthesizer Node"
  }
