{
  "project": {
    "name": "Anjishnu Story Experience",
    "version": "1.0.0",
    "description": "Production-ready reverse-engineered specification of the Anjishnu story experience derived from refer.mp4 reference recording.",
    "theme": "Cyberpunk Cinematic Editorial Hybrid",
    "targetFps": 60,
    "viewportStandard": {
      "desktop": { "width": 1600, "height": 850 },
      "mobile": { "width": 375, "height": 667 }
    }
  },
  "designSystem": {
    "units": {
      "baseFontSize": "62.5%",
      "rootRem": "1rem = 10px"
    },
    "tokens": {
      "menuPad": "2.0rem",
      "menuHeight": "5.6rem",
      "menuWidth": "6.7rem",
      "menuRadius": "2.0rem",
      "lineThickness": "1px",
      "contentMaxWidth": "144.0rem"
    },
    "borderRadius": {
      "none": "0px",
      "xs": "0.26rem",
      "sm": "0.5rem",
      "md": "0.8rem",
      "lg": "1.4rem",
      "xl": "2.0rem",
      "full": "9999px"
    },
    "spacingScale": {
      "1": "0.4rem",
      "2": "0.8rem",
      "3": "1.2rem",
      "4": "1.6rem",
      "5": "2.0rem",
      "6": "2.4rem",
      "8": "3.2rem",
      "10": "4.0rem",
      "12": "4.8rem",
      "16": "6.4rem",
      "20": "8.0rem",
      "24": "9.6rem",
      "32": "12.8rem"
    },
    "containerWidths": {
      "sm": "64.0rem",
      "md": "96.0rem",
      "lg": "120.0rem",
      "xl": "144.0rem",
      "full": "100%"
    },
    "zIndexLayers": {
      "canvas": 0,
      "content": 1,
      "overlays": 10,
      "hudFrame": 50,
      "menuDrawer": 60,
      "modal": 70,
      "preloader": 100
    },
    "transitionDefaults": {
      "fast": "0.2s ease",
      "normal": "0.4s cubic-bezier(0.16, 1, 0.3, 1)",
      "slow": "0.8s cubic-bezier(0.16, 1, 0.3, 1)",
      "linear": "0.1s linear"
    }
  },
  "colors": {
    "primary": {
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "secondary": {
      "slateDark": "#0A0A0A",
      "slateMedium": "#141414",
      "slateLight": "#222222",
      "charcoal": "#333333"
    },
    "background": {
      "canvasLight": "#FFFFFF",
      "canvasDark": "#000000",
      "canvasLavender": "#DDD8F5",
      "canvasLavenderLight": "#EAE6F8",
      "canvasSunset": "#C88470",
      "canvasSunsetSecondary": "#936068"
    },
    "text": {
      "primaryLight": "#000000",
      "primaryDark": "#FFFFFF",
      "mutedLight": "rgba(0, 0, 0, 0.45)",
      "mutedDark": "rgba(255, 255, 255, 0.45)",
      "disabled": "rgba(255, 255, 255, 0.2)"
    },
    "accent": {
      "neonGreen": "#C0FB50",
      "neonBlue": "#8CA6FF",
      "lavender": "#B39DDB",
      "gold": "#FFD54F"
    },
    "lines": {
      "darkOnLight": "rgba(0, 0, 0, 0.12)",
      "lightOnDark": "rgba(255, 255, 255, 0.15)",
      "activeLine": "#C0FB50"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": "Space Grotesk, ABCWhytePlus, sans-serif",
      "mono": "JetBrains Mono, IBMPlexMono, monospace",
      "body": "Space Grotesk, sans-serif"
    },
    "scale": {
      "megaWatermark": { "fontSize": "clamp(8.0rem, 16vw, 24.0rem)", "lineHeight": "0.8", "letterSpacing": "-0.06em", "fontWeight": 700 },
      "displayH1": { "fontSize": "clamp(3.6rem, 6.5vw, 7.2rem)", "lineHeight": "0.9", "letterSpacing": "-0.05em", "fontWeight": 700 },
      "displayH2": { "fontSize": "clamp(2.8rem, 4.5vw, 4.8rem)", "lineHeight": "1.0", "letterSpacing": "-0.04em", "fontWeight": 700 },
      "sectionH3": { "fontSize": "clamp(2.0rem, 2.8vw, 3.2rem)", "lineHeight": "1.1", "letterSpacing": "-0.03em", "fontWeight": 600 },
      "bodyLead": { "fontSize": "clamp(1.6rem, 2.0vw, 2.2rem)", "lineHeight": "1.4", "letterSpacing": "-0.01em", "fontWeight": 400 },
      "bodyRegular": { "fontSize": "clamp(1.4rem, 1.6vw, 1.6rem)", "lineHeight": "1.6", "letterSpacing": "0", "fontWeight": 400 },
      "labelMono": { "fontSize": "1.1rem", "lineHeight": "1.0", "letterSpacing": "0.12em", "fontWeight": 500, "textTransform": "uppercase" },
      "telemetryMono": { "fontSize": "0.9rem", "lineHeight": "1.0", "letterSpacing": "0.18em", "fontWeight": 400, "textTransform": "uppercase" }
    }
  },
  "navigation": {
    "hudFrame": {
      "inset": "var(--menu-pad)",
      "borderThickness": "1px",
      "borderColor": "var(--color-lines)"
    },
    "header": {
      "height": "var(--menu-height)",
      "left": {
        "width": "var(--menu-width)",
        "component": "BtnBurger",
        "icon": "icon_burger_2bar"
      },
      "center": {
        "component": "HudNavTabs",
        "tabs": [
          { "id": "project", "label": "PROJECT", "target": "#chapter-project", "order": 1 },
          { "id": "keep", "label": "THE KEEP", "target": "#chapter-keep", "order": 2 },
          { "id": "factions", "label": "FACTIONS", "target": "#chapter-factions", "order": 3 },
          { "id": "world", "label": "THE WORLD", "target": "#chapter-world", "order": 4 }
        ]
      },
      "right": {
        "component": "BtnAuth",
        "label": "SIGN IN",
        "variant": "pillLight"
      }
    },
    "progressBar": {
      "height": "1px",
      "position": "bottomOfHeader",
      "color": "var(--color-text-primary)"
    },
    "sidebarRail": {
      "width": "var(--menu-width)",
      "elements": [
        { "type": "crosshairReticle", "position": "centerVertical", "icon": "icon_crosshair_diamond" },
        { "type": "audioVisualizer", "position": "bottomLeft", "bars": 5, "label": "[01]" }
      ]
    }
  },
  "pages": [
    {
      "id": "page_story_home",
      "title": "Anjishnu | Story",
      "slug": "/",
      "layout": "LayoutHudDefault",
      "sections": [
        "section_hero_genesis",
        "section_intro_split",
        "section_keep_telemetry",
        "section_matrix_wipe",
        "section_collectibles_carousel",
        "section_factions_citadel",
        "section_factions_overlook",
        "section_world_keepers",
        "section_footer_monoliths"
      ]
    }
  ],
  "sections": [
    {
      "id": "section_hero_genesis",
      "type": "heroPinnedStage",
      "order": 1,
      "purpose": "First impression presenting the primary cyberpunk protagonist with cybernetic implants and celestial aura in a branded folder-tab card.",
      "background": {
        "color": "#EAE6F8",
        "type": "paintedSkyGradient",
        "assetRef": "asset_bg_lavender_sky"
      },
      "content": {
        "badge": "• PROJECT",
        "cardMetadata": "• DECIMAL CARD",
        "protagonistName": "ANJISHNU PROTO-01"
      },
      "typography": {
        "navLabel": "labelMono"
      },
      "images": ["asset_hero_protagonist_card"],
      "layout": {
        "display": "flex",
        "height": "100vh",
        "justifyContent": "center",
        "alignItems": "center",
        "pin": true
      },
      "dimensions": {
        "cardWidthDesktop": "48.0rem",
        "cardHeightDesktop": "60.0rem",
        "cardWidthMobile": "88vw",
        "cardHeightMobile": "52.0rem"
      },
      "alignment": "center",
      "spacing": {
        "padding": "var(--menu-pad)"
      },
      "animation": {
        "entry": "anim_hero_card_fade_in",
        "scrollScrub": "anim_hero_card_shrink_and_dock"
      },
      "scrollBehavior": {
        "pinned": true,
        "scrubDuration": "100vh"
      },
      "interactions": [
        { "type": "mouseParallax", "target": "asset_hero_protagonist_card", "factor": 0.04 }
      ],
      "responsiveBehavior": {
        "mobile": {
          "scaleCard": 0.85,
          "repositionOffset": "top"
        }
      },
      "dependencies": ["TheHudFrame", "HeroCard", "useLenis"]
    },
    {
      "id": "section_intro_split",
      "type": "asymmetricThreeColumn",
      "order": 2,
      "purpose": "Introduce the narrative context of New Eden safe zone with a multi-layered 3-column asymmetric layout.",
      "background": {
        "color": "#FFFFFF",
        "type": "solid"
      },
      "content": {
        "indexLabel": "• 001",
        "headline": "A FAMILIAR WORLD... SET ON A DIFFERENT PATH.",
        "description": "Isolated within the New Eden safe zone, you witness humanity struggling to avoid descending into chaos.",
        "videoLabel": "SEC_VIDEO_1P",
        "centerCardLabel": "• DECIMAL CARD",
        "rightCardLabel": "• SPIRE GUARDIAN"
      },
      "typography": {
        "index": "labelMono",
        "headline": "displayH1",
        "body": "bodyRegular"
      },
      "images": [
        "asset_hero_protagonist_card",
        "asset_video_thumbnail_safezone",
        "asset_card_spire_warrior"
      ],
      "layout": {
        "display": "grid",
        "gridColumnsDesktop": "1.2fr 1fr 1fr",
        "gridColumnsMobile": "1fr",
        "minHeight": "100vh",
        "alignItems": "center"
      },
      "dimensions": {
        "videoThumbnailWidth": "16.0rem",
        "videoThumbnailHeight": "10.0rem",
        "spireCardHeight": "68.0rem"
      },
      "alignment": "left",
      "spacing": {
        "paddingTop": "12.0rem",
        "paddingBottom": "12.0rem",
        "columnGap": "4.8rem"
      },
      "animation": {
        "scrollScrub": "anim_intro_columns_stagger_enter"
      },
      "scrollBehavior": {
        "pinned": false
      },
      "interactions": [
        { "type": "hoverTilt", "target": "asset_card_spire_warrior", "maxAngle": 4 }
      ],
      "responsiveBehavior": {
        "mobile": {
          "stackOrder": ["headline", "centerCard", "videoThumbnail", "spireCard"]
        }
      },
      "dependencies": ["VideoThumbnail", "PerspectiveCard", "FolderTabCard"]
    },
    {
      "id": "section_keep_telemetry",
      "type": "panoramicTelemetryStage",
      "order": 3,
      "purpose": "Immerse user in the vast scale of The Keep with mountain landscape, philosophical inquiry, and live technical coordinates.",
      "background": {
        "color": "#C88470",
        "type": "paintedSunsetMountains",
        "assetRef": "asset_bg_sunset_vista"
      },
      "content": {
        "indexLabel": "• 002",
        "headline": "YOU ARE A KEEPER: AN AGENT OF POWER AND CHANGE IN THIS WORLD.",
        "subHeadline": "WHAT WILL YOU DO WITH THIS POWER? WILL YOU CHOOSE TO PROTECT OR DESTROY? TO GIVE OR TO TAKE?",
        "coordinates": "N 38°31' 14\" / E 120°15' 08\"",
        "altitude": "ALT 3510 M",
        "reticleLabel": "• KEEPERS SYMBOL"
      },
      "typography": {
        "index": "labelMono",
        "headline": "displayH1",
        "subHeadline": "sectionH3",
        "telemetry": "telemetryMono"
      },
      "images": [
        "asset_drone_aircraft",
        "asset_wireframe_terrain_mesh"
      ],
      "layout": {
        "display": "flex",
        "flexDirection": "column",
        "justifyContent": "space-between",
        "height": "160vh",
        "pin": true
      },
      "dimensions": {
        "terrainMeshWidth": "32.0rem",
        "terrainMeshHeight": "14.0rem"
      },
      "alignment": "left",
      "spacing": {
        "padding": "var(--menu-pad)"
      },
      "animation": {
        "scrollScrub": "anim_telemetry_narrative_scrub",
        "continuous": "anim_aircraft_flight_path"
      },
      "scrollBehavior": {
        "pinned": true,
        "scrubDuration": "160vh"
      },
      "interactions": [
        { "type": "radarSweep", "target": "asset_wireframe_terrain_mesh" }
      ],
      "responsiveBehavior": {
        "mobile": {
          "hideTerrainMesh": true,
          "repositionCoordinates": "topRight"
        }
      },
      "dependencies": ["TelemetryCoordinates", "TerrainMeshGraphic", "FlightDrone"]
    },
    {
      "id": "section_matrix_wipe",
      "type": "graphicCurtainTransition",
      "order": 4,
      "purpose": "A theatrical visual bridge between narrative lore and the digital collectibles chapter via a vertical capsule matrix wipe.",
      "background": {
        "color": "transparent",
        "type": "overlayCurtain"
      },
      "content": {},
      "typography": {},
      "images": [],
      "layout": {
        "display": "grid",
        "gridColumns": "repeat(8, 1fr)",
        "height": "100vh",
        "overflow": "hidden"
      },
      "dimensions": {
        "capsuleWidth": "8.0rem",
        "capsuleHeight": "18.0rem"
      },
      "alignment": "center",
      "spacing": { "gap": "1.0rem" },
      "animation": {
        "scrollScrub": "anim_capsule_matrix_wipe"
      },
      "scrollBehavior": {
        "pinned": true,
        "scrubDuration": "80vh"
      },
      "interactions": [],
      "responsiveBehavior": {
        "mobile": {
          "gridColumns": "repeat(4, 1fr)"
        }
      },
      "dependencies": ["TransitionMatrix"]
    },
    {
      "id": "section_collectibles_carousel",
      "type": "horizontalFannedShowcase",
      "order": 5,
      "purpose": "Showcase the 10,000 avatar collectible assets with an interactive horizontal card fan deck and 10K giant watermark.",
      "background": {
        "color": "#DDD8F5",
        "type": "solidLavender"
      },
      "content": {
        "indexLabel": "• 003",
        "watermarkText": "10K",
        "headline": "10,000 UNIQUE DIGITAL COLLECTIBLES.",
        "categoryLabel": "• INITIAL COLLECTION",
        "description": "Every Keeper is born, endowed with attributes from a collection of over 400 meticulously hand-painted assets. They are personable, iconic possessions that represent Anjishnu's foundational pillars of evolution, inclusion, and imagination.",
        "navChevrons": { "prev": "◄", "next": "►" }
      },
      "typography": {
        "index": "labelMono",
        "watermark": "megaWatermark",
        "headline": "displayH2",
        "category": "labelMono",
        "body": "bodyRegular"
      },
      "images": [
        "asset_card_avatar_01",
        "asset_card_avatar_02",
        "asset_card_avatar_03",
        "asset_card_avatar_04",
        "asset_card_avatar_05",
        "asset_card_avatar_06",
        "asset_card_avatar_07"
      ],
      "layout": {
        "display": "flex",
        "flexDirection": "column",
        "height": "140vh",
        "pin": true
      },
      "dimensions": {
        "cardWidth": "28.0rem",
        "cardHeight": "38.0rem",
        "activeCardScale": 1.05
      },
      "alignment": "center",
      "spacing": {
        "padding": "var(--menu-pad)",
        "cardGap": "2.4rem"
      },
      "animation": {
        "scrollScrub": "anim_collectibles_fan_spread"
      },
      "scrollBehavior": {
        "pinned": true,
        "scrubDuration": "140vh"
      },
      "interactions": [
        { "type": "cardHoverLift", "target": "collectibleCard", "scale": 1.04 },
        { "type": "chevronClickSlide", "target": "cardDeck", "step": "1card" }
      ],
      "responsiveBehavior": {
        "mobile": {
          "cardWidth": "24.0rem",
          "cardHeight": "32.0rem",
          "touchSwipe": true
        }
      },
      "dependencies": ["CollectiblesDeck", "CollectiblesCard", "HudChevronNav"]
    },
    {
      "id": "section_factions_citadel",
      "type": "folderTabVistaStage",
      "order": 6,
      "purpose": "Unveil the floating ring citadel metropolis through a large folder-tab masked viewport.",
      "background": {
        "color": "#E5DDF0",
        "type": "skyHaze"
      },
      "content": {
        "badge": "• FACTIONS"
      },
      "typography": {
        "badge": "labelMono"
      },
      "images": ["asset_citadel_ring_metropolis"],
      "layout": {
        "display": "flex",
        "justifyContent": "center",
        "alignItems": "center",
        "height": "100vh"
      },
      "dimensions": {
        "maskWidthDesktop": "110.0rem",
        "maskHeightDesktop": "64.0rem"
      },
      "alignment": "center",
      "spacing": { "padding": "var(--menu-pad)" },
      "animation": {
        "scrollScrub": "anim_citadel_mask_expand"
      },
      "scrollBehavior": { "pinned": true, "scrubDuration": "80vh" },
      "interactions": [],
      "responsiveBehavior": {
        "mobile": { "maskWidth": "92vw", "maskHeight": "48.0rem" }
      },
      "dependencies": ["FolderTabMask"]
    },
    {
      "id": "section_factions_overlook",
      "type": "characterOverlookInteractive",
      "order": 7,
      "purpose": "Present the two opposing faction leaders on the balcony with an interactive Click & Hold reticle trigger.",
      "background": {
        "color": "#EAA899",
        "type": "sunsetBalconyGradient",
        "assetRef": "asset_bg_balcony_sunset"
      },
      "content": {
        "indexLabel": "• 002 • FACTIONS",
        "tagline": "One world, two factions. Divided in belief, united in purpose.",
        "interactivePrompt": "CLICK & HOLD"
      },
      "typography": {
        "index": "labelMono",
        "tagline": "bodyLead",
        "prompt": "labelMono"
      },
      "images": [
        "asset_faction_pink_leader",
        "asset_faction_silver_warrior"
      ],
      "layout": {
        "display": "flex",
        "flexDirection": "column",
        "justifyContent": "space-between",
        "height": "120vh",
        "pin": true
      },
      "dimensions": {
        "reticleDiameter": "10.0rem"
      },
      "alignment": "center",
      "spacing": { "padding": "var(--menu-pad)" },
      "animation": {
        "scrollScrub": "anim_overlook_depth_parallax"
      },
      "scrollBehavior": { "pinned": true, "scrubDuration": "120vh" },
      "interactions": [
        {
          "type": "pointerHold",
          "target": "ClickHoldReticle",
          "holdTimeMs": 1500,
          "action": "triggerFactionLoreModal"
        }
      ],
      "responsiveBehavior": {
        "mobile": {
          "repositionReticle": "centerLow"
        }
      },
      "dependencies": ["ClickHoldReticle", "ParallaxLayer"]
    },
    {
      "id": "section_world_keepers",
