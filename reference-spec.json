        "pin": true
      },
      "dimensions": {
        "card1Width": "32.0rem",
        "card1Height": "38.0rem",
        "card2Width": "24.0rem",
        "card2Height": "42.0rem",
        "card3Width": "36.0rem",
        "card3Height": "20.0rem"
      },
