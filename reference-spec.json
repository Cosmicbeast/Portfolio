  ],
  "components": [
    {
      "name": "TheHudFrame",
      "path": "components/hud/TheHudFrame.vue",
      "role": "Global fixed viewport frame overlay with 1px border and reactive dark/light themes",
      "props": { "currentTheme": "string", "scrollProgress": "number" },
      "children": ["HudNavTabs", "HudProgressBar", "HudLeftRail", "BtnBurger", "BtnAuth"]
    },
    {
      "name": "HudNavTabs",
      "path": "components/hud/HudNavTabs.vue",
      "role": "Horizontal chapter navigation with dynamic active dot and opacity toggling",
      "props": { "activeTabId": "string", "tabs": "Array" }
    },
    {
      "name": "HudProgressBar",
      "path": "components/hud/HudProgressBar.vue",
      "role": "1px horizontal line indicating total scroll percentage",
      "props": { "progress": "number" }
    },
    {
      "name": "HudLeftRail",
      "path": "components/hud/HudLeftRail.vue",
      "role": "Vertical rail housing central crosshair reticle and bottom audio waveform visualizer",
      "props": { "audioPlaying": "boolean" }
    },
    {
      "name": "FolderTabCard",
      "path": "components/cards/FolderTabCard.vue",
      "role": "Card with custom asymmetrical folder-tab notch and rounded borders",
      "props": { "image": "string", "badge": "string", "alt": "string" }
    },
    {
      "name": "CollectiblesDeck",
      "path": "components/collectibles/CollectiblesDeck.vue",
      "role": "Fanned horizontal card deck for the 10,000 digital collectibles",
      "props": { "cards": "Array", "activeIndex": "number" }
    },
    {
      "name": "ClickHoldReticle",
      "path": "components/ui/ClickHoldReticle.vue",
      "role": "Interactive SVG circular radar button requiring 1.5s pointer hold",
      "props": { "label": "string", "durationMs": "number" },
      "emits": ["holdComplete"]
    },
    {
      "name": "HackyTextScramble",
      "path": "components/animation/HackyTextScramble.vue",
      "role": "Scramble text effect without layout shift using spacer technique",
      "props": { "text": "string", "trigger": "string", "speed": "number" }
    },
    {
      "name": "LinkHoverFill",
      "path": "components/animation/LinkHoverFill.vue",
      "role": "Sliding background fill sweeping left-to-right on link hover",
      "props": { "href": "string", "accentColor": "string" }
    },
    {
      "name": "MegaWordmark",
      "path": "components/ui/MegaWordmark.vue",
      "role": "Full-width brutalist SVG letterforms (KEEPERS, ANJISHNU)",
      "props": { "word": "string", "color": "string" }
    }
